    "@langchain/aws": "^1.4.6",
    "@langchain/core": "^1.2.13",
    "@langchain/google": "^0.2.8",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.6.0",
    "@langchain/openrouter": "^0.4.15",
    "@pizza-bot/core": "*",
    "@pizza-bot/plugin-sdk": "*",
    "@smithy/core": "^3.35.0",
    "@smithy/signature-v4": "^5.7.4"
  }
