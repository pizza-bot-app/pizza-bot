    "@langchain/core": "^1.2.1",
    "@langchain/google": "^0.2.1",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "@langchain/openrouter": "^0.4.6",
    "@pizza-bot/core": "*",
    "@pizza-bot/plugin-sdk": "*",
    "@smithy/core": "^3.31.1"
  }
