{
  "name": "@pizza-bot/inference-providers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Built-in model providers and api-server registration for Bedrock, Anthropic, Google Gemini, OpenAI, OpenRouter, and Ollama.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc -b",
