[Unit]
Description=Pizza Bot backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pizza-bot
Group=pizza-bot
WorkingDirectory=/opt/pizza-bot/backend
Environment=HOME=/var/lib/pizza-bot
EnvironmentFile=/etc/pizza-bot/pizza-bot.env
ExecStart=/usr/bin/node /opt/pizza-bot/backend/start.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/pizza-bot

[Install]
WantedBy=multi-user.target
